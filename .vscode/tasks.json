{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Démarrer le serveur PHP",
            "type": "shell",
            "command": "php -S localhost:8000 -t public/",
            "group": "build",
            "isBackground": true,
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": {
                "pattern": {
                    "regexp": "^(.*)$",
                    "file": 1,
                    "line": 1,
                    "message": 1
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^.*Development Server.*started.*$",
                    "endsPattern": "^.*$"
                }
            }
        }
    ]
}
